# ADDING NEW STATES
# =================
# 1. Create script extending State in scripts/enemies/
# 2. Implement: enter(), exit(), update(), physics_update(), check_transitions()
# 3. Add ext_resource to Enemy.tscn
# 4. Add node under StateMachine with script attached
# 5. Reference from other states via transition_to("state_name")
#
# State template:
#   ```gdscript
#   class_name EnemyCustomState
#   extends State
#
#   var parent: Enemy
#   var animated_sprite: AnimatedSprite2D
#
#   func enter():
#       parent = get_parent().get_parent()
#       animated_sprite = parent.get_node("AnimatedSprite2D")
#
#   func physics_update(_delta: float):
#       if parent.is_dead:
#           return
#       # Your logic
#       check_transitions()
#
#   func check_transitions():
#       if condition:
#           transition_to("chase")
#   ```

# DEBUG VISUALIZATION
# ===================
# Enable in Inspector:
#   - debug_draw_ai: Line to target (green=visible, red=blocked)
#   - debug_draw_detection: Vision cones, attack range, awareness bar

# FILE REFERENCE
# ==============
# Enemy.gd: Main class with vision, awareness, personality
# EnemyIdleState.gd: Patrol behavior
# EnemySuspiciousState.gd: Investigation after glimpse
# EnemyChaseState.gd: Active pursuit with smart direction
# EnemyAttackState.gd: Telegraph → Strike → Recovery
# EnemySearchState.gd: Last known position search
# EnemyHurtState.gd: Damage stagger
# EnemyMovementComponent.gd: Movement interface
# README_ENEMY_AI.md: Complete documentation

# NAMING CONVENTIONS
# ==================
# States: Enemy{Behavior}State (e.g., EnemyChaseState)
# Enemy types: {Type}Enemy (e.g., FastEnemy, HeavyEnemy)
# Scene files: {Type}Enemy.tscn or Enemy.tscn for base

# INTEGRATION NOTES
# =================
# - Enemies use the same State/StateMachine pattern as Player
# - Stomp kills handled in Enemy._check_player_collision()
# - Damage dealt via Enemy._damage_player() which notifies HealthManager
# - Room changes may require re-acquiring player target
# - Physics priority: Enemy runs after Player (priority 100)
# - State machine runs before Enemy (priority 50)
