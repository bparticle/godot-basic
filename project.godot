; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="pimpa-raka"
run/main_scene="res://scenes/Game.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.101960786, 0.101960786, 0.101960786, 1)
boot_splash/use_filter=false
boot_splash/image="uid://den26vybk2yjp"
config/icon="res://icon.svg"

[autoload]

RoomManager="*res://scripts/managers/RoomManager.gd"
HealthManager="*res://scripts/managers/HealthManager.gd"
GameStateManager="*res://scripts/managers/GameStateManager.gd"
RNG="*res://scripts/managers/RNG.gd"
SceneChanger="*res://scripts/managers/SceneChanger.gd"
EffectsManager="*res://scripts/managers/EffectsManager.gd"

[display]

# HYBRID MODE: 3x internal resolution for smooth effects while keeping pixel art aesthetic
# Original was 300x300 with 2x scale. Now 900x900 (3x art scale) for effect fidelity.
# Sprites still use Nearest filter and look chunky, but effects can be smooth.
window/size/viewport_width=900
window/size/viewport_height=900
window/size/mode=2
window/size/window_width_override=900
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/scale=1.0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
